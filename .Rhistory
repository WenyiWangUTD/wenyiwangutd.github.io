setwd("/Users/wangmay/YRBSS/national total/comparison")
library(haven)
library(dplyr)
library(PSweight)
library(lmtest)
library(sandwich)
library(ggplot2)
library(tidyverse)
#import data
temp = list.files(pattern="\\.sav$")
year <- c(2015, 2017, 2019, 2021, 2023)
name <- c()
for (i in 1:length(temp)) {
name <- c(name, paste0("yrbs", year[i]))
assign(name[i], read_sav(temp[i]))
assign(name[i],
data.frame(year = year[i],
get(name[i]),
no = seq(1, nrow(get(name[i])))))
}
